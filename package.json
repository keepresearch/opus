{
  "name": "@discordjs/opus",
  "version": "0.10.1-keepresearch.1",
  "description": "Node-API Opus bindings with libopus 1.6.1 SIMD and GitHub Release prebuilds",
  "main": "lib/index.js",
  "types": "typings/index.d.ts",
  "author": "iCrawl <icrawltogo@gmail.com>",
  "license": "MIT",
  "scripts": {
    "install": "node lib/install.js",
    "build:source": "node scripts/build-source.js",
    "package:binary": "node scripts/package-binary.js",
    "lint": "prettier --check .",
    "test": "node --expose-gc --test tests/*.test.js",
    "typecheck": "tsc --noEmit --skipLibCheck --types node typings/index.d.ts"
  },
  "keywords": [
    "native",
    "opus",
    "module",
    "c",
    "c++",
    "bindings",
    "binary"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keepresearch/opus.git"
  },
  "dependencies": {
    "node-addon-api": "8.5.0",
    "node-gyp": "12.1.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "private": true,
  "files": [
    "lib",
    "scripts",
    "src",
    "binding.gyp",
    "vendor",
    "typings",
    "LICENSE",
    "README.md"
  ]
}
